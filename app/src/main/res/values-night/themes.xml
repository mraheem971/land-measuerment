<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LandMeasurement" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand & Colors -->
        <item name="colorPrimary">@color/pak_green_accent</item>
        <item name="colorOnPrimary">@color/pak_green_dark</item>
        <item name="colorPrimaryContainer">@color/pak_dark_surface_variant</item>
        <item name="colorOnPrimaryContainer">@color/pak_green_subtle</item>
        <item name="colorSecondary">@color/pak_gold_accent</item>
        <item name="colorOnSecondary">@color/pak_green_dark</item>
        <item name="colorSecondaryContainer">@color/pak_dark_surface_variant</item>
        <item name="colorOnSecondaryContainer">@color/pak_gold_light</item>
        <item name="colorTertiary">@color/pak_green_light</item>
        <item name="colorError">@color/pak_error</item>
        <item name="android:colorBackground">@color/pak_dark_bg</item>
        <item name="colorSurface">@color/pak_dark_surface</item>
        <item name="colorSurfaceVariant">@color/pak_dark_surface_variant</item>
        <item name="colorOnSurface">@color/pak_text_primary_dark</item>
        <item name="colorOnSurfaceVariant">@color/pak_text_secondary_dark</item>
        
        <!-- Status Bar and Navigation Bar -->
        <item name="android:statusBarColor">@color/pak_dark_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/pak_dark_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>